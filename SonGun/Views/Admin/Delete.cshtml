@model SonGun.Models.News

@{
    ViewData["Title"] = "Haber Sil";
}

<div class="row justify-content-center" data-aos="fade-up">
    <div class="col-lg-8 col-md-10">
        <div class="card card-theme shadow-sm rounded-3 p-4 border-danger">
            <h2 class="text-danger fw-bold mb-3"><i class="fas fa-exclamation-triangle me-2"></i>Haber Silme Onayı</h2>
            <p class="text-muted-custom mb-4">Bu haberi kalıcı olarak silmek istediğinizden emin misiniz?</p>

            <div class="p-3 rounded-2 bg-body-tertiary mb-4">
                <h4 class="theme-heading fw-bold">@Model.Title</h4>
                <div class="small text-muted-custom mb-2">
                    <span class="me-3"><i class="fas fa-user me-1"></i>@Model.Author</span>
                    <span><i class="far fa-clock me-1"></i>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <p class="mb-0 text-muted-custom">
                    @(Model.Content.Length > 200 ? Model.Content.Substring(0, 200) + "..." : Model.Content)
                </p>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4 me-2">
                    <i class="fas fa-trash-alt me-1"></i> Evet, Kalıcı Olarak Sil
                </button>
                <a asp-action="Index" class="btn btn-secondary px-4">
                    İptal
                </a>
            </form>
        </div>
    </div>
</div>
