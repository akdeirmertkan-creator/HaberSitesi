@model SonGun.Models.ViewModels.NewsCreateEditViewModel

@{
    ViewData["Title"] = "Yeni Haber Ekle";
}

<div class="row justify-content-center" data-aos="fade-up">
    <div class="col-lg-8 col-md-10">
        <div class="card card-theme shadow-sm rounded-3 p-4">
            <h2 class="theme-heading fw-bold mb-4"><i class="fas fa-plus-circle me-2"></i>Yeni Haber Ekle</h2>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control input-theme" placeholder="Haber başlığı" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label fw-semibold"></label>
                    <textarea asp-for="Content" class="form-control input-theme" rows="6" placeholder="Haber içeriğini buraya yazın..."></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
                    <input asp-for="ImageUrl" class="form-control input-theme" placeholder="https://example.com/resim.jpg" />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-theme-primary px-4">
                        <i class="fas fa-save me-1"></i> Yayınla
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        İptal
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
